{
  "name": "@pulse/api",
  "version": "0.26.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/local.ts",
    "dev:wrangler": "wrangler dev --env dev",
    "build": "wrangler deploy --env dev --dry-run --outdir dist",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run",
    "test:d1": "bun test src/d1-integration.test.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "1.4.15",
    "@pulse/db": "workspace:*",
    "@shared/crypto": "workspace:*",
    "@shared/db-utils": "workspace:*",
    "@shared/observability": "workspace:*",
    "@shared/openapi-tools": "workspace:*",
    "@shared/osn-auth-client": "workspace:*",
    "@shared/rate-limit": "workspace:*",
    "@shared/redis": "workspace:*",
    "@zap/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.0",
    "elysia": "^1.4.29",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@effect/vitest": "^0.30.0",
    "@shared/typescript-config": "workspace:*",
    "miniflare": "^4.20260722.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
