{
  "name": "@pulse/db",
  "version": "0.20.8",
  "private": true,
  "type": "module",
  "author": "English Street Ventures Pty Ltd",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/englishstreetventures/osn.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./service": "./src/service.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db:migrate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:seed": "bun run src/seed.ts",
    "db:reset": "bash ../../scripts/db-reset.sh PULSE_DATABASE_URL ../../data/pulse.db",
    "db:migrate:local": "bunx wrangler --config ../api/wrangler.toml d1 migrations apply pulse-db --env dev --local",
    "db:migrate:dev": "bunx wrangler --config ../api/wrangler.toml d1 migrations apply pulse-db --env dev --remote",
    "db:migrate:staging": "bunx wrangler --config ../api/wrangler.toml d1 migrations apply pulse-db-staging --env staging --remote",
    "db:migrate:prod": "bunx wrangler --config ../api/wrangler.toml d1 migrations apply pulse-db-prod --env production --remote",
    "db:reset:local": "rm -rf ../api/.wrangler/state/v3/d1 && bun run db:migrate:local",
    "check": "tsc --noEmit",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run"
  },
  "dependencies": {
    "@shared/db-utils": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@effect/vitest": "4.0.3",
    "@shared/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
