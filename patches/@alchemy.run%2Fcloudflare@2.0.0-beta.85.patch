+      ).pipe(
+        Effect.flatMap((envelope) => {
+          const listed = envelope.result;
+          const total = envelope.result_info?.total_count;
+          if (!Array.isArray(listed)) {
+            return Effect.fail(
+              new CallFailed(`reading ${host}'s DNS records: Cloudflare answered no list`, [], 200),
+            );
+          }
+          if (typeof total === "number" && total > listed.length) {
+            return Effect.fail(
+              new CallFailed(
+                `reading ${host}'s DNS records: Cloudflare holds ${total}, more than one page`,
+                [],
+                200,
+              ),
+            );
+          }
+          return Effect.succeed(listed as DnsRecord[]);
+        }),
+      );
