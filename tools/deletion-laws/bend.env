# The one pin of the Bend release the deletion proofs run on: the version, the
# SHA-256 of each platform's release tarball
# (github.com/bendlang/bend/releases/download/v<version>/bend-<version>-<target>.tar.gz),
# as bend-lang.com/install.sh records them for that version, and the SHA-256
# of the bin/bend each tarball holds. scripts/install-bend.sh checks every
# tarball against the first; bend.sh checks the installed binary against the
# second before every run; CI's `bend-proofs` job reads this file.
BEND_VERSION=2.0.40
BEND_SHA256_DARWIN_ARM64=b2be003b041eb6cfc65326be18f79eb2e0bae2189be79a18c507e661b4b6900b
BEND_SHA256_DARWIN_X64=9229c8bdd0a93f63fa45cc5af5e9e56389ebb620d655920915daf966c6ca561c
BEND_SHA256_LINUX_ARM64=2f42a6fa34ecdaa71ae105e5fa734f9a07e129d333e45448ab6d2ff03a837570
BEND_SHA256_LINUX_X64=c9ff8d67bd903fb6ad9a26b43d8a62c01021de82a44d55ce4a3dcd4732113d6b
BEND_BIN_SHA256_DARWIN_ARM64=c362cdac355d84f51278db97cb29a3b2e0be084d59b76a5cff013199b3513539
BEND_BIN_SHA256_DARWIN_X64=f1293311b395ef33dda8579d1a23656aaaa3dab8613690de25d5f1b870812898
BEND_BIN_SHA256_LINUX_ARM64=f5ba5a289969c5156bf656d2375176e28953f35d76fbef4141f6cc43a422e880
