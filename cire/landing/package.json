    "@shared/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@shared/dev-urls": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "happy-dom": "^21.0.4",
