{
  "name": "@osn/api",
  "version": "3.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "dev-env bun run --watch src/local.ts",
    "dev:wrangler": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir ./dist",
    "deploy": "wrangler deploy --env production",
    "types": "wrangler types",
    "start": "bun run src/local.ts",
    "check": "tsc --noEmit",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run",
    "test:d1": "bun test tests/d1/d1-integration.test.ts"
  },
  "portless": {
    "name": "id.musubi",
    "script": "dev:app"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@osn/db": "workspace:*",
    "@shared/crypto": "workspace:*",
    "@shared/db-utils": "workspace:*",
    "@shared/email": "workspace:*",
    "@shared/observability": "workspace:*",
    "@shared/openapi-tools": "workspace:*",
    "@shared/rate-limit": "workspace:*",
    "@shared/redis": "workspace:*",
    "@shared/turnstile": "workspace:*",
    "@simplewebauthn/server": "^13.3.3",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.112",
    "elysia": "^1.4.30",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@effect/vitest": "4.0.0-rc.112",
    "@shared/dev-urls": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "miniflare": "^4.20260730.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
