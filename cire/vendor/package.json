{
  "name": "@cire/vendor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "dev-env astro dev",
    "build": "astro build && bun run ../../scripts/check-astro-fonts.ts dist",
    "preview": "astro preview",
    "check": "bunx --bun astro check",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run"
  },
  "portless": {
    "name": "vendor.cire",
    "script": "dev:app"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@cire/theme": "workspace:*",
    "@kobalte/core": "^0.13.13",
    "@shared/rp-auth": "workspace:*",
    "@shared/toast": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "web-haptics": "0.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@shared/dev-urls": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.10.0",
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
