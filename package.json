{
  "name": "osn",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["cire/*", "osn/*", "pulse/*", "zap/*", "shared/*"],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:pulse": "turbo dev --filter=@pulse/api --filter=@pulse/web --filter=@osn/api --filter=@zap/api",
    "dev:zap": "turbo dev --filter=@zap/api --filter=@osn/api",
    "dev:osn": "turbo dev --filter=@osn/api",
    "dev:social": "turbo dev --filter=@osn/social --filter=@osn/api",
    "dev:apis": "turbo dev --filter=@osn/api --filter=@pulse/api --filter=@zap/api",
    "dev:cire": "turbo dev --filter=@cire/api --filter=@cire/invites --filter=@cire/host --filter=@osn/api",
    "dev:cire-landing": "turbo dev --filter=@cire/landing",
    "dev:landing": "turbo dev --filter=@osn/landing",
    "dev:pulse-landing": "turbo dev --filter=@pulse/landing",
    "lint": "oxlint -c oxlintrc.json .",
    "check": "turbo check",
    "test": "turbo test --continue",
    "test:d1": "turbo test:d1 --continue --concurrency=1",
    "test:browser": "turbo test:browser --continue",
    "test:migration": "bun test scripts/todo-to-issues/",
    "clean": "git clean -fdX",
    "db:reset": "bun run --cwd osn/db db:reset && bun run --cwd pulse/db db:reset && bun run --cwd zap/db db:reset && bun run --cwd cire/db db:reset",
    "fmt": "bunx --bun oxfmt osn pulse zap shared cire '!**/*.{json,jsonc,md,yml,yaml,css,html,astro}'",
    "fmt:check": "bunx --bun oxfmt osn pulse zap shared cire '!**/*.{json,jsonc,md,yml,yaml,css,html,astro}' --check",
    "reset": "bun run clean && bun i",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@oxlint/plugins": "1.78.0",
    "bun-types": "^1.3.14",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "1.78.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@opentelemetry/core": "^2.9.0",
    "devalue": "^5.8.1",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.25",
    "protobufjs": "^7.5.5",
    "seroval": "^1.5.3",
    "sharp": "^0.35.0",
    "svgo": "^4.0.2",
    "smol-toml": "^1.6.1",
    "undici": "^7.29.0",
    "vite": "^8.0.13",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  }
}
