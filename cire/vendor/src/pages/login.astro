---
import { Font } from 'astro:assets'

import SignInCard from '@cire/ui/sign-in-card.astro'

import '../styles/global.css'
import { CIRE_API_URL } from '../lib/osn'
import { THEME_BOOT_SCRIPT } from '../lib/preference-keys'
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Vendor portal — Cire</title>
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>
    <Font cssVariable="--font-ui" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-flair" preload={[{ subset: "latin" }]} />
  </head>
  <!--
    No island owns this page's chrome, so the theme is whatever the boot script
    resolved. That is the whole of it: there is nothing here to keep in sync
    with an OS that flips mid-session, and the one control that would change it
    lives behind the sign-in this page exists to get past.

    The page's body is `@cire/ui`'s `SignInCard`, the same as the host
    portal's but for the portal's name. Its heading is sized from the page's
    container, so the body carries `@container/frame`.
  -->
  <body class="@container/frame">
    <SignInCard portal="vendor" apiBase={CIRE_API_URL} />
  </body>
</html>
