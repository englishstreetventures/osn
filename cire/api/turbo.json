{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // tests/scripts/d1-latency-probe.test.ts reads three files outside this
    // package: the probe's workflow, @shared/infra's hosts.ts, whose
    // PRODUCTION_ZONES the probe repeats, and scripts/smoke-check.ts, whose
    // CI_USER_AGENT the probe sends. Named here, a change to any of them
    // re-runs the suite rather than replaying a cached green.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/shared/infra/src/hosts.ts",
        "$TURBO_ROOT$/.github/workflows/cire-d1-latency-probe.yml",
        "$TURBO_ROOT$/scripts/smoke-check.ts"
      ]
    }
  }
}
