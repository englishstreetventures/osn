{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PORTLESS"],
  // `shared/test-config/no-jest-dom.ts` belongs to no package, so no task's
  // `inputs` hash covers it — every consumer's `test` result would stay cached
  // across an edit to it, including an edit that put executable code in a file
  // whose whole contract is to hold none. Listed here, a change to it
  // invalidates every task in the repo, which is the blunt version of correct.
  "globalDependencies": ["shared/test-config/no-jest-dom.ts"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        "build/**"
      ],
      "env": ["PUBLIC_*", "VITE_*", "SITE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "fmt": {},
    "check": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:d1": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "VITEST_BROWSER_EXECUTABLE_PATH",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"
      ]
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
