---
import { DEMO_ANCHOR, DEMO_INVITE_URL, ORGANISER_URL } from '../../lib/site'
const demoHref = DEMO_INVITE_URL ?? DEMO_ANCHOR
const external = DEMO_INVITE_URL !== null
---
<section class="hero section-wrap" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="eyebrow">For everything that makes it yours</p>
    <h1 id="hero-heading" class="display">Your wedding.<br /><span>Beautifully together.</span></h1>
    <p class="hero-description">Beautiful invitations. Thoughtful planning. One place to bring your wedding together.</p>
    <div class="hero-actions">
      <a href={ORGANISER_URL} class="cta-primary">Start your wedding free <span aria-hidden="true">↗</span></a>
      <a href={demoHref} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="text-link">Explore the invitation <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero-product" aria-label="Example Cire invitation and planning workspace">
    <div class="hero-invite"><img src="/images/classic.webp" width="900" height="1200" alt="Classic invitation for the example wedding of Amara and Sam, with their photograph, names and date" fetchpriority="high" /></div>
    <div class="hero-workspace"><img src="/images/overview.webp" width="1920" height="1350" alt="Cire organiser overview showing upcoming tasks, guest replies and wedding planning" /></div>
    <p class="product-caption">A warm welcome for them. A little breathing room for you.</p>
  </div>
</section>
<div class="hero-foundation section-wrap" aria-label="Included with Cire">
  <p>Made personal.<br /><span>From the very first invitation.</span></p>
  <p>Guests feel welcome.<br /><span>No app or account needed.</span></p>
  <p>Start with Ivory, free.<br /><span>For up to 100 guests.</span></p>
</div>
