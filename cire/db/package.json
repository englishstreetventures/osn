{
  "name": "@cire/db",
  "private": true,
  "type": "module",
  "author": "English Street Ventures Pty Ltd",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/englishstventures/osn.git"
  },
  "exports": {
    ".": "./src/schema.ts",
    "./seed": "./seed/data/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "seed:generate": "bun run seed/generate.ts",
    "assets:seed:dev": "bun run seed/assets.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "bun run ../../scripts/cire-db-migrate.ts cire-db --local",
    "db:migrate:local": "bun run ../../scripts/cire-db-migrate.ts cire-db --local",
    "db:migrate:dev": "bun run ../../scripts/cire-db-migrate.ts cire-db-dev --env dev --remote",
    "db:migrate:prod": "bun run ../../scripts/cire-db-migrate.ts cire-db --env production --remote",
    "db:seed": "bash ../../scripts/cire-db-seed.sh",
    "db:seed:dev": "bash ../../scripts/cire-db-seed.sh --dev",
    "db:reset": "rm -rf ../api/.wrangler/state/v3/d1 && bun run db:push && bun run db:seed",
    "db:reset:dev": "bash ../../scripts/cire-db-reset.sh --dev"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10"
  }
}
