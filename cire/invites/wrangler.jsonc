{
  // Cire guest site — Astro SSR deployed as a Cloudflare Worker with Static
  // Assets (the `@astrojs/cloudflare` adapter emits `dist/server/entry.mjs` +
  // `dist/client/` and a generated `dist/server/wrangler.json` that EXTENDS this
  // file). The invite route (`/<slug>`) + bare-domain redirect (`/`) are
  // server-rendered per request; legal pages prerender to static assets.
  //
  // Deploy: `wrangler deploy` from `cire/invites` (config below is picked up; the
  // adapter merges its generated `main`/`assets` into it). See deploy.yml.
  "name": "cire-invites",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs are sampled at 100% (low guest-site volume). Mirrors
  // cire-api's logging posture. Invocation records are off: each stores the
  // request URL, and `/<slug>` carries the wedding slug (the couple's names).
  // Application logs stay on. Native traces cover existing path links as well
  // as the fixed query routes generated for new guest links. Dev overrides this
  // block to trace without query redaction.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // The SSR build is minified (astro.config.mjs); upload source maps so a
  // production exception still symbolicates to a real source line. The
  // adapter never sets this itself (grepped `@astrojs/cloudflare/dist` for
  // `upload_source_maps`: no hits) — it must come from this file, which the
  // adapter's generated `dist/server/wrangler.json` extends.
  "upload_source_maps": true,
  // Custom-domain route: serves the guest site on `invite.cireweddings.com`.
  // (Domain reshuffle 2026-07-16: the apex `cireweddings.com` now serves the
  // marketing landing site; guest invites moved to the `invite.` subdomain,
  // organisers to `host.`.) `custom_domain: true` auto-provisions DNS + edge
  // cert because the zone lives in this Cloudflare account. Applied only by
  // `wrangler deploy` (no named env).
  "routes": [{ "pattern": "invite.cireweddings.com", "custom_domain": true }],
}
