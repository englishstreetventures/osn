---
// The document every legal page on both guest-facing sites renders through:
// the guest site's `/privacy` and `/terms`, and the marketing site's privacy
// notices, terms and refunds. One layout, so a guest who follows "Privacy
// notice" from an invitation reads it set the same way as on cireweddings.com.
//
// A whole document with four slots, because each site brings what only it has:
//   head    — the site's own preloads and meta, after the title;
//   default — the page;
//   footer  — the site's footer (`site-footer.astro`, as that site fills it);
//   after   — anything that follows the footer, the guest site's consent banner.
// The site's stylesheet is the site's: each site wraps this in a page of its
// own that imports it, since a package cannot import an app's CSS.
//
// The page's rules are global (`.legal …`) because the page's markup is the
// caller's, in the default slot, where this file's scope does not reach. Every
// colour and face is a `--ui-*` name both sites map; a literal left has no
// token at its value, and is marked.

interface Props {
  /** The page's title: the tab's, and the reader's way to tell two tabs apart. */
  title: string
  /** Added after the title in the tab, "<title> — <siteName>". */
  siteName?: string
  /** A line back to the site above the page, where there is somewhere to go back to. */
  back?: { href: string; label: string }
}

const { title, siteName, back } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Keeps a page's query (the guest site's `?code=` preview credential) out
        of a cross-origin Referer; the sites' headers say the same. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{siteName ? `${title} — ${siteName}` : title}</title>
    <slot name="head" />
  </head>
  <body>
    <main class="legal">
      {
        back && (
          <p class="legal-back">
            <a href={back.href}>{back.label}</a>
          </p>
        )
      }
      <slot />
    </main>
    <slot name="footer" />
    <slot name="after" />
    <style is:global>
      .legal {
        max-width: var(--ui-measure-xl, 46rem);
        margin: 0 auto;
        padding: 3.5rem 1.5rem 1rem;
      }

      .legal a {
        color: var(--ui-accent-ink);
      }

      /* A link label, so sentence case, as cire's link labels are. */
      .legal-back a {
        font-family: var(--ui-font-body);
        /* No type token at 0.8125rem. */
        font-size: 0.8125rem;
        color: var(--ui-ink-secondary);
        text-decoration: none;
        transition: color var(--dur-fast, var(--ui-dur-fast)) var(--ease-out, var(--ui-ease-out));
      }

      .legal-back a:hover {
        color: var(--ui-accent-ink);
      }

      .legal-back a:focus-visible {
        outline: 2px solid var(--ui-focus);
        outline-offset: 3px;
        border-radius: var(--ui-radius-hair);
      }

      /* Shown while a detail the page publishes is still a placeholder: the
         pages draw it, gated on the fields they publish. */
      .legal .draft-banner {
        border: 1px solid var(--ui-accent-soft);
        background: var(--ui-surface-raised);
        border-radius: var(--ui-radius-sm);
        /* No spacing token at 0.875rem × 1.125rem. */
        padding: 0.875rem 1.125rem;
        margin: 0 0 2.5rem;
        /* No type token at 0.875rem. */
        font-size: 0.875rem;
        color: var(--ui-ink-secondary);
      }

      .legal-back + .draft-banner {
        margin-top: 1.5rem;
      }

      .legal .draft-banner strong {
        color: var(--ui-accent-ink);
        font-weight: 400;
        letter-spacing: var(--ui-tracking-wide);
        text-transform: uppercase;
      }

      .legal h1 {
        font-family: var(--ui-font-display);
        font-weight: 400;
        /* No type token on this clamp. */
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: var(--ui-leading-none);
        margin: 0 0 0.5rem;
      }

      .legal h2 {
        font-family: var(--ui-font-display);
        font-weight: 600;
        /* No type token at 1.375rem. */
        font-size: 1.375rem;
        margin: 2.25rem 0 0.625rem;
      }

      /* Sub-sections: the guest notice uses them. */
      .legal h3 {
        font-family: var(--ui-font-body);
        font-weight: 400;
        font-size: 1rem;
        /* No tracking token at 0.02em. */
        letter-spacing: 0.02em;
        margin: 1.25rem 0 0.375rem;
        color: var(--ui-accent-ink);
      }

      .legal p,
      .legal li {
        color: var(--ui-ink);
        /* No type token at 0.9375rem, nor leading at 1.65. */
        font-size: 0.9375rem;
        line-height: 1.65;
      }

      .legal .meta {
        color: var(--ui-ink-secondary);
        font-size: 0.8125rem;
        margin-top: 0;
      }

      .legal ul {
        padding-left: 1.25rem;
        margin: 0.5rem 0 1rem;
      }

      .legal li {
        margin-bottom: 0.35rem;
      }

      /* A detail still to be filled in: the mono face and the readable gold
         mark it, with no wash behind it. Each site holds that gold to 4.5:1
         against its page alone; a gold wash under gold text takes it below. */
      .legal .placeholder {
        color: var(--ui-accent-ink);
        font-family: var(--ui-font-mono);
        font-size: 0.85em;
      }
    </style>
  </body>
</html>
