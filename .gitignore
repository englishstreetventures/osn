# Based on https://raw.githubusercontent.com/github/gitignore/main/Node.gitignore

# Logs

logs
_.log
npm-debug.log_
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)

report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# Runtime data

pids
_.pid
_.seed
\*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover

lib-cov

# Coverage directory used by tools like istanbul

coverage
\*.lcov

# nyc test coverage

.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)

.grunt

# Bower dependency directory (https://bower.io/)

bower_components

# node-waf configuration

.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)

build/Release

# Dependency directories

node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)

web_modules/

# TypeScript cache

\*.tsbuildinfo

# Optional npm cache directory

.npm

# Optional eslint cache

.eslintcache

# Optional stylelint cache

.stylelintcache

# Microbundle cache

.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history

.node_repl_history

# Output of 'npm pack'

\*.tgz

# Yarn Integrity file

.yarn-integrity

# dotenv environment variable files

.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# wrangler local secret overrides (.dev.vars.example IS tracked)
.dev.vars
!.dev.vars.example

# parcel-bundler cache (https://parceljs.org/)

.cache
.parcel-cache

# Next.js build output

.next
out

# Nuxt.js build / generate output

.nuxt
dist

# Gatsby files

.cache/

# Comment in the public line in if your project uses Gatsby and not Next.js

# https://nextjs.org/blog/next-9-1#public-directory-support

# public

# vuepress build output

.vuepress/dist

# vuepress v2.x temp and cache directory

.temp
.cache

# Docusaurus cache and generated files

.docusaurus

# Serverless directories

.serverless/

# FuseBox cache

.fusebox/

# DynamoDB Local files

.dynamodb/

# TernJS port file

.tern-port

# Stores VSCode versions used for testing VSCode extensions

.vscode-test

# yarn v2

.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.\*

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# misc
**/tmp

# Turborepo
.turbo

# Wrangler local state (D1/KV/R2 emulation, build cache)
.wrangler/

# Astro
.astro

# SolidStart / Vinxi
.output
app.config.timestamp_*.js

# Local data
data/
# …but the cire dev-seed canonical data is committed source, not local data.
!cire/db/seed/data/

# Obsidian (wiki vault user state)
wiki/.obsidian/

# Caveman compress backups
*.original.md

# Claude Code agent worktrees (transient, per-session)
.claude/worktrees/

# Private business/legal planning notes — never committed
wiki/business/

# Vitest browser-mode artifacts (transient, per-run). Vitest writes a screenshot
# and an attachment for every FAILING browser test, next to the test file. They
# are debugging aids for the run that produced them — regenerated on the next
# failure and meaningless once the test is fixed. See
# [[wiki/conventions/browser-tests]].
**/__screenshots__/
**/.vitest-attachments/

# Xcode / SwiftPM (generated, never committed)
*.xcodeproj
# XcodeGen writes the entitlements plist from the `entitlements.properties`
# block in `project.yml`, same as it writes the `.xcodeproj` — the committed
# source of truth is the YAML, not the generated plist.
*/ios/*.entitlements
# Same deal for the Info.plist: XcodeGen writes it from the `info.properties`
# block in `project.yml`, which is where the per-configuration tier and hosts
# are declared. Committing the output would let it drift from that source.
*/ios/*-Info.plist
.build/
DerivedData/
.swiftpm/

# Regenerate with `bun run migrate:plan`. The sibling created.json is NOT ignored:
# it maps source lines to the issues already created, and `bun run clean` would
# take it out with everything else ignored here.
.migration/manifest.json
# Shards handed to the disclosure audit, regenerated from the manifest.
.migration/audit/

# Shallow checkouts of an upstream repo, cloned as reference material by a
# migration or a skill that needs to read someone else's source. Never ours,
# and never committed — the Effect v4 migration's two clones lived here.
.repos/

# Scratch written by the agent skills and read back after a compaction, never
# committed: `new-feat` writes the branch's plan and gate state, `stress-plan`
# the attack on that plan, `prep-pr` the PR body and its report, and each
# `review-*` skill its own report — `prep-pr` dispatches three of those on every
# run, so they land at the checkout root where a careless `git add -A` would take
# them. They are per-branch working notes, not repository documentation; what
# belongs to the repo goes in the wiki or the PR body.
#
# `orchestrate`'s own `ORCHESTRATE.md` is deliberately absent: it is written at
# the bare repo's root, outside every worktree, so nothing here governs it and no
# worktree can stage it.
NEW-FEAT.md
PLAN-REVIEW.md
PR-BODY.md
PREP-PR-REPORT.md
DOCS-REVIEW.md
TEST-REVIEW.md
PERFORMANCE-REVIEW.md
SECURITY-REVIEW.md
DEPS-REVIEW.md
# A one-off evaluation a workflow wrote for the owner to decide from. Same kind
# of thing: what survives the decision goes to the wiki, not to the root.
TSDOC-EVALUATION.md
