---
import { Font } from 'astro:assets'

import '../styles/global.css'
import SignInPanel from '../components/SignInPanel'
import { THEME_BOOT_SCRIPT } from '../lib/theme-boot'
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Vendor — Cire</title>
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>
    <Font cssVariable="--font-ui" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-flair" preload={[{ subset: "latin" }]} />
  </head>
  <!--
    No island owns this page's chrome, so the theme is whatever the boot script
    resolved. That is the whole of it: there is nothing here to keep in sync
    with an OS that flips mid-session, and the one control that would change it
    lives behind the sign-in this page exists to get past.

    `--page-max` is the knob `page-frame` reads. A sign-in card at the portal's
    full measure is a 68rem-wide box holding two buttons.
  -->
  <body class="@container/frame">
    <main class="page-frame flex min-h-dvh flex-col justify-center py-16 [--page-max:26rem]">
      <header class="mb-8 flex flex-col gap-1.5 text-center">
        <p class="font-body text-gold text-[0.7rem] tracking-[0.18em] uppercase">Vendor Portal</p>
        <h1 class="font-display text-text text-[clamp(1.9rem,5cqi,2.6rem)] leading-[1.1] font-light">
          Sign in
        </h1>
      </header>
      <div class="border-border bg-surface/30 lip rounded-sm border p-8">
        <SignInPanel client:only="solid-js" />
      </div>
    </main>
  </body>
</html>
