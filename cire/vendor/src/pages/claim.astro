---
import { Font } from 'astro:assets'

import '../styles/global.css'
import ClaimApp from '../components/ClaimApp'
import { THEME_BOOT_SCRIPT } from '../lib/theme-boot'
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Claim your listing — Vendor — Cire</title>
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>
    <Font cssVariable="--font-ui" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-flair" preload={[{ subset: "latin" }]} />
  </head>
  <body class="@container/frame">
    <main class="page-frame py-16 [--page-max:40rem]">
      <header class="mb-8 flex flex-col gap-1.5">
        <p class="font-body text-gold text-[0.7rem] tracking-[0.18em] uppercase">Vendor Portal</p>
        <h1 class="font-display text-text text-[clamp(1.9rem,5cqi,2.8rem)] leading-[1.1] font-light">
          Claim your listing
        </h1>
        <hr class="gilt-rule mt-3" />
      </header>
      <ClaimApp client:only="solid-js" />
    </main>
  </body>
</html>
