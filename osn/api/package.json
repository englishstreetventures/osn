{
  "name": "@osn/api",
  "version": "3.20.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/local.ts",
    "dev:wrangler": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir ./dist",
    "deploy": "wrangler deploy --env production",
    "types": "wrangler types",
    "start": "bun run src/local.ts",
    "check": "tsc --noEmit",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run",
    "test:d1": "bun test src/d1-integration.test.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@osn/db": "workspace:*",
    "@shared/crypto": "workspace:*",
    "@shared/db-utils": "workspace:*",
    "@shared/email": "workspace:*",
    "@shared/observability": "workspace:*",
    "@shared/openapi-tools": "workspace:*",
    "@shared/rate-limit": "workspace:*",
    "@shared/redis": "workspace:*",
    "@shared/turnstile": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.0",
    "elysia": "^1.4.29",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@effect/vitest": "^0.30.0",
    "@shared/typescript-config": "workspace:*",
    "miniflare": "^4.20260722.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
