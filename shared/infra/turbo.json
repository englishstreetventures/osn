{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The `package` project reads only this package's files; the `repo`
    // project (vitest.config.ts) also reads the Worker sources, the lockfile
    // (which pins the wrangler and alchemy it reads), the root turbo.json,
    // the cire packages' own turbo.json, the workflows, the stack
    // declarations and the asset sites' public directories, so only it reruns
    // when one of those changes. tests/package.test.ts holds the last two to
    // the sites the tests read.
    "test": {
      "dependsOn": ["^build", "test:repo"]
    },
    "test:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/osn/api/src/**",
        "$TURBO_ROOT$/cire/api/src/**",
        "$TURBO_ROOT$/zap/api/src/**",
        "$TURBO_ROOT$/cire/invites/src/**",
        "$TURBO_ROOT$/osn/api/wrangler.toml",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/cire/*/turbo.json",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/cire/infra/src/declaration.ts",
        "$TURBO_ROOT$/musubi/infra/src/declaration.ts",
        "$TURBO_ROOT$/pulse/infra/src/declaration.ts",
        "$TURBO_ROOT$/zap/infra/src/declaration.ts",
        "$TURBO_ROOT$/cire/host/public/**",
        "$TURBO_ROOT$/cire/vendor/public/**",
        "$TURBO_ROOT$/cire/landing/public/**",
        "$TURBO_ROOT$/cire/invites/public/**",
        "$TURBO_ROOT$/musubi/social/public/**",
        "$TURBO_ROOT$/musubi/landing/public/**",
        "$TURBO_ROOT$/pulse/landing/public/**"
      ]
    }
  }
}
