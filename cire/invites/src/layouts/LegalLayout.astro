---
import '../styles/global.css'
import SiteFooter from '../components/SiteFooter.astro'
import { ConsentBanner } from '../components/consent/ConsentBanner'

interface Props {
  title: string
}

const { title } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Keep the ?code= preview credential out of cross-origin Referer headers. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
  </head>
  <body>
    <main class="legal">
      <slot />
    </main>
    <SiteFooter />
    {/* Site-wide consent surface. `client:idle` so it never competes with the
        invite's first paint — nothing third-party can load before it hydrates
        anyway, since every ConsentGate defaults to denied until then.
        `prompt="banner"`: elsewhere the prompt is a dialog the guest must
        answer, but the prompt links here, and a dialog on this page would stand
        between the guest and the notice they came to read before deciding. */}
    <ConsentBanner client:idle prompt="banner" />
    <style is:global>
      .legal {
        max-width: var(--ui-measure-xl, 46rem);
        margin: 0 auto;
        padding: 3.5rem 1.5rem 1rem;
      }

      .legal a {
        color: var(--color-gold-ink);
      }

      .legal .draft-banner {
        border: 1px solid var(--color-gold-dim);
        background: var(--color-surface-raised);
        border-radius: var(--radius-sm);
        padding: 0.875rem 1.125rem;
        margin-bottom: 2.5rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .legal .draft-banner strong {
        color: var(--color-gold-ink);
        font-weight: 400;
        letter-spacing: var(--ui-tracking-wide);
        text-transform: uppercase;
      }

      .legal h1 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: var(--ui-leading-none);
        margin: 0 0 0.5rem;
      }

      .legal h2 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.375rem;
        margin: 2.25rem 0 0.625rem;
      }

      .legal h3 {
        font-family: var(--font-body);
        font-weight: 400;
        font-size: 1rem;
        letter-spacing: 0.02em;
        margin: 1.25rem 0 0.375rem;
        color: var(--color-gold-ink);
      }

      .legal p,
      .legal li {
        color: var(--color-text);
        font-size: 0.9375rem;
        line-height: 1.65;
      }

      .legal .meta {
        color: var(--color-text-muted);
        font-size: 0.8125rem;
        margin-top: 0;
      }

      .legal ul {
        padding-left: 1.25rem;
        margin: 0.5rem 0 1rem;
      }

      .legal li {
        margin-bottom: 0.35rem;
      }

      /* A detail still to be filled in: the mono face and the readable gold
         mark it, with no highlight behind it, since the palette holds that gold
         to 4.5:1 against the page alone. */
      .legal .placeholder {
        color: var(--color-gold-ink);
        font-family: var(--ui-font-mono);
        font-size: 0.85em;
      }

      .legal .owner-note {
        border-left: 2px solid var(--color-gold-dim);
        background: var(--color-surface-raised);
        /* Square on the ruled side, so the rule runs straight top to bottom. */
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        padding: 0.625rem 0.875rem;
        margin: 0.75rem 0 1rem;
        font-size: 0.8125rem;
        color: var(--color-text-muted);
      }

      .legal .owner-note strong {
        color: var(--color-gold-ink);
        font-weight: 400;
      }
    </style>
  </body>
</html>
