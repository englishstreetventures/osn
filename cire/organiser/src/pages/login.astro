---
import { Font } from 'astro:assets'

import '../styles/global.css'
import SignInPanel from '../components/SignInPanel'
import { THEME_BOOT_SCRIPT } from '../lib/theme-boot'
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Host Dashboard — Cire</title>
    <!-- Same boot script as the dashboard, for the same reason: sign-in is the
         first page a host sees, and it is the one most likely to be opened at
         night. It must not paint a frame of the wrong theme. -->
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>
    <Font cssVariable="--font-ui" preload />
    <Font cssVariable="--font-flair" preload />
  </head>
  <body>
    <!-- Same `page-frame` gutters as the dashboard, with its own measure: a
         sign-in card has one job and doesn't grow with the screen. -->
    <main class="page-frame py-24 [--page-max:30rem]">
      <header class="mb-8 flex flex-col gap-2 text-center">
        <p class="font-body text-[0.72rem] uppercase tracking-[0.2em] text-gold">
          Cire · Host Dashboard
        </p>
        <h1 class="font-display text-[clamp(1.8rem,4vw,2.5rem)] font-light italic leading-[1.1] text-text">
          Sign in
        </h1>
      </header>
      <div class="rounded-sm border border-border bg-surface p-8">
        <SignInPanel client:only="solid-js" />
      </div>
    </main>
  </body>
</html>
