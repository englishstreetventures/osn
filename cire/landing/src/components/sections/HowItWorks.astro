---
const steps = [
  { title: 'Make a little space for your day.', body: 'Create your wedding for free. Add your events and guest list, and invite a co-host to help.' },
  { title: 'Make the invitation yours.', body: 'Choose your design, add your photographs and words, then share your wedding link and household codes.' },
  { title: 'Bring it all together.', body: 'Gather the replies. Keep your plans close. Add Gold or Crimson when you need more room or planning tools.' },
]
---
<section id="how-it-works" class="how-section section-wrap section-space" aria-labelledby="how-heading">
  <div class="how-intro" data-reveal><h2 id="how-heading" class="display">A beginning,<br />not another to-do.</h2><p>You do not need every detail settled.<br />Just somewhere to start.</p></div>
  <ol class="how-steps">{steps.map((step,i) => <li data-reveal><span class="step-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol>
</section>
