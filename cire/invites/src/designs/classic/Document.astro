---
import '../../styles/global.css'
import { apiPreconnectHref } from '../../lib/api-origin'
import { inviteTitle } from '../../lib/invite-title'
import { heroPreloadHref } from '../../components/invite-images'
import InviteHeader from './InviteHeader'
import InvitePage from './InvitePage'
import { filterThemeVars, paletteRootVars, sectionVars, styleAttr } from '../../components/invite-theme'
import { heroState } from '../../components/invite-emptiness'
import { EDGE_BOOT_SCRIPT, EDGE_STRIP_CLASS, edgeStyle, serverEdgeColours } from '../../components/edge-boot'
import { ENVELOPE_BOOT_SCRIPT, envelopeStyle } from '@cire/envelope/boot'
import { envelopeKeyFor } from '../../components/envelope-key'
import { Z_CLASS, Z_LAYER } from '../../lib/z-index'
import { GiftRegistryTeaserIsland } from '../../components/gift-registry/GiftRegistryTeaserIsland'
import SiteFooter from '../../components/SiteFooter.astro'
import { ConsentBanner } from '../../components/consent/ConsentBanner'
import type { InviteDesignProps } from '../types'

type Props = InviteDesignProps

const { apiUrl, slug, initialInvite, siteUrl } = Astro.props

// Preload the hero (the LCP element) — the exact `hero-bg` URL `InviteHeader`
// renders, or nothing when the hero has no image or is switched off. See
// `heroPreloadHref` for why it is one variant and not a responsive set.
const preloadHeroHref = heroPreloadHref(apiUrl, initialInvite)

// Tab title follows the couple's hero title when they've set one (e.g.
// "Anita & Ben — You're Invited"); the built-in default otherwise.
const pageTitle = inviteTitle(initialInvite?.hero.title)
// The invite's colour scheme, derived once and written into the SSR'd HTML so
// the FIRST paint is already themed. Without this a cream invite would flash
// the built-in dark green until the island hydrated. When the route had no
// payload, the islands' browser-side retry re-applies it (`applyPaletteToRoot`)
// once the invite arrives.
const palette = paletteRootVars(initialInvite?.theme ?? null)
const paletteStyle = styleAttr(palette)
// The first-paint edge colours (issue #1700). The hero is shown when the same
// state function the client uses says so, so the server and client agree.
const heroShown =
  heroState(initialInvite?.visibility?.hero, {
    imageUrl: initialInvite?.hero?.imageUrl,
    title: initialInvite?.hero?.title,
    subtitle: initialInvite?.hero?.subtitle,
  }) === 'shown'
const edgeColours = serverEdgeColours(palette, heroShown)
const edgeInline = edgeStyle(edgeColours)

// The envelope opening's key: set only for a wedding with a catalog envelope
// over a shown hero (`envelopeKeyFor`). With none, the boot script below never
// seals the page and the page is exactly the page without an envelope.
const envelopeKey = await envelopeKeyFor({ slug, envelopeId: initialInvite?.envelopeId, heroShown })
// A page that opens from an envelope loads its hero image in anonymous CORS
// mode: the preload, the backdrop `<img>` and its crop layers, and the
// opening's own copy then share one cached response instead of two
// (cire-api's image responses vary on `Origin`). Every other page loads it as
// it always has.
const heroCrossOrigin = envelopeKey ? 'anonymous' : undefined

// Warm the browser's connection to cire-api. See `lib/api-origin.ts` for why
// this is separate from the hero preload and why it carries no `crossorigin`;
// a page that opens from an envelope warms the anonymous pool as well.
const apiPreconnect = apiPreconnectHref(apiUrl)

// The gift-list band's surface, resolved server-side from the same SSR payload
// every other section uses — it keeps the registry section's own tone, so the
// band and the page it links to sit on the same colour. Filtered through the
// allow-list because it is spread into a `style` object in the island.
const registryVars = filterThemeVars(sectionVars(initialInvite?.theme ?? null, 'registry'))
---
<!DOCTYPE html>
<html lang="en" style={`${paletteStyle};${edgeInline}`} data-design="classic" data-envelope-key={envelopeKey ?? undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={edgeColours.top} />
    {/* Sets the safe-area classes before first paint. Runs after the viewport meta:
        iOS reports the insets as 0 until viewport-fit=cover is in effect. */}
    <script is:inline set:html={EDGE_BOOT_SCRIPT}></script>
    {/* The envelope opening: its stylesheet and boot script before first paint,
        so a sealed page is covered from its first frame and an unsealed one
        never is. Both are constants; the only per-request input is the
        `data-envelope-key` attribute above. */}
    <style is:inline set:html={envelopeStyle(Z_LAYER.ENVELOPE)}></style>
    <script is:inline set:html={ENVELOPE_BOOT_SCRIPT}></script>
    {/* S-L1: keep the ?code= preview credential out of cross-origin Referer headers. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    {/* First-party API origin, hinted BEFORE the third-party font hosts: the
        claim POST (and the session restore beside it) is the interaction the
        guest is waiting on, and the hero image is served from here too.

        The credentialed pool (no `crossorigin`) serves the claim POST, the
        session restore, RSVP, the islands' `GET /api/invite/:slug` retry when
        the route's own fetch failed, and the hero <img>. On a page that opens
        from an envelope the hero loads anonymously instead (`heroCrossOrigin`),
        so that page warms the anonymous pool too; the preload carries the
        same mode as the <img>, or it is wasted. */}
    {apiPreconnect && <link rel="preconnect" href={apiPreconnect} />}
    {apiPreconnect && heroCrossOrigin && <link rel="preconnect" href={apiPreconnect} crossorigin={heroCrossOrigin} />}
    {preloadHeroHref && <link rel="preload" as="image" href={preloadHeroHref} crossorigin={heroCrossOrigin} />}
  </head>
  <body class="invite-page">
    <div class={`${EDGE_STRIP_CLASS} edge-top ${Z_CLASS.EDGE}`} aria-hidden="true"></div>
    <InviteHeader client:load apiUrl={apiUrl} slug={slug} initial={initialInvite} imageCrossOrigin={heroCrossOrigin} />
    {/* rootMargin so the island hydrates while the full-viewport hero is
        still on screen. Bare `client:visible` cannot fire at scroll position
        0 (the hero is `min-h-dvh`), which would delay the session restore
        until the guest has already scrolled to the code form — i.e. to the
        exact moment they are waiting on its result. */}
    <InvitePage
      client:visible={{ rootMargin: "600px" }}
      apiUrl={apiUrl}
      slug={slug}
      siteUrl={siteUrl}
      theme={initialInvite?.theme ?? null}
      details={initialInvite?.details ?? null}
      welcomeMessage={initialInvite?.welcome?.message ?? null}
      inviteMissing={initialInvite === null}
    />
    {/* The couple's gift list — a band that links to it, not the list itself:
        that lives at `/<slug>/registry`, because it is the part of an
        invitation a guest comes BACK to. It is its own island, mounted after
        InvitePage, though nothing about the band requires that: its read
        sits behind the same claim gate as the rest of the invitation, so it
        renders NOTHING for a visitor with no claim (401) or a wedding with no
        published list (404), and nested in InvitePage's claim-gated body it
        would appear at the same moment it does now. What the split costs: the
        two islands share no Solid root, so the band learns of a claim or a
        sign-out only through `CLAIM_SESSION_EVENT` (`claim-session.ts`), and it
        keeps an always-present wrapper element so `client:visible` has
        something to observe (`GiftRegistryTeaserIsland.tsx`). Moving it inside
        InvitePage, behind the claim, would drop both. The island holds only
        the list read; the band's own code downloads once that read answers
        with a list, so a guest of a wedding without one never downloads it. */}
    <GiftRegistryTeaserIsland
      client:visible={{ rootMargin: "600px" }}
      apiUrl={apiUrl}
      slug={slug}
      eyebrow={initialInvite?.registry?.eyebrow ?? null}
      heading={initialInvite?.registry?.heading ?? null}
      body={initialInvite?.registry?.body ?? null}
      themeVars={registryVars}
    />
    {/* Site-wide chrome: the couple's name over the legal links. Always here,
        on the invite and on the legal pages alike. The couple's own sign-off is
        a section INSIDE InvitePage above — it sits behind the claim gate. */}
    {/* Plays the envelope opening again. Hidden unless this browser can play
        it and this invite has one (the head stylesheet); beside the footer,
        since the guest site has no menu. */}
    <div class="text-center">
      <button type="button" data-envelope-replay>Open the envelope again</button>
    </div>
    <SiteFooter closing={initialInvite?.hero.title ?? null} />
    {/* Site-wide consent surface. `client:idle` so it never competes with the
        invite's first paint — nothing third-party can load before it hydrates
        anyway, since every ConsentGate defaults to denied until then. */}
    <ConsentBanner client:idle />
    <div class={`${EDGE_STRIP_CLASS} edge-bottom ${Z_CLASS.EDGE}`} aria-hidden="true"></div>
  </body>
</html>

<script>
  import { startEdgeColours } from '../../components/edge-boot'
  import { startEnvelope } from '../../components/envelope-mount'
  startEdgeColours()
  startEnvelope()
</script>
