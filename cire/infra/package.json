{
  "name": "@cire/infra",
  "private": true,
  "type": "module",
  "author": "English Street Ventures Pty Ltd",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/englishstreetventures/osn.git"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run",
    "test:mutation": "bun ../../tools/stryker/src/cli.ts",
    "plan:dev": "CI=true DO_NOT_TRACK=1 bun alchemy plan --stage dev",
    "deploy:dev": "CI=true DO_NOT_TRACK=1 bun alchemy deploy --stage dev --yes",
    "plan:production": "CI=true DO_NOT_TRACK=1 bun alchemy deploy --stage production --dry-run",
    "deploy:production": "CI=true DO_NOT_TRACK=1 bun alchemy deploy --stage production --yes",
    "plan:guard": "bun run scripts/plan-guard.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@shared/infra": "workspace:*",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "vitest": "5.0.5"
  }
}
