{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PORTLESS"],
  // `shared/test-config/no-jest-dom.ts` belongs to no package, so no task's
  // `inputs` hash covers it — every consumer's `test` result would stay cached
  // across an edit to it, including an edit that put executable code in a file
  // whose whole contract is to hold none. Listed here, a change to it
  // invalidates every task in the repo, which is the blunt version of correct.
  // `.browserslistrc` is the same case for builds: Babel core reads it on every
  // Solid transform (it resolves `targets` from it), and it too sits in no
  // package. `patches/**` holds the dependency patches `bun install` applies;
  // `bun.lock` records only their paths, so an edit to one changes no other
  // input and would otherwise serve every cached test from before it. The
  // migration scripts sit in no package either, and the db and cire/api test
  // suites import them to replay and list migrations.
  "globalDependencies": [
    "shared/test-config/no-jest-dom.ts",
    ".browserslistrc",
    "patches/**",
    "scripts/migration-files.ts",
    "scripts/cire-db-migrate.ts",
    "scripts/db-generate.ts",
    "scripts/check-migration-orders.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**"],
      "env": ["PUBLIC_*", "VITE_*", "SITE"],
      // Strict env mode hides every variable not named here. cire/invites'
      // dev build sets ASTRO_KEY so two builds of one commit are
      // byte-identical; without it Astro makes a new key on every build.
      // Passed through, not hashed: a secret's value stays out of the cache
      // key.
      "passThroughEnv": ["ASTRO_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    // A package type-checks the source of the workspace packages it imports
    // (they export `src/*.ts`), so its `typecheck` result depends on theirs as
    // well as its own files. `transit` has no script in any package: it exists
    // so `typecheck` hashes every workspace dependency's files through
    // `^transit`, and an edit to `shared/db-utils` re-runs
    // `@cire/api#typecheck` rather than replaying a cached green.
    // `dependsOn: ["^typecheck"]` would cover the same files but also wait for
    // each dependency's typecheck to finish first, for no gain: the checker
    // reads a dependency's source, never its typecheck output.
    // Markdown is left out because the checker never reads it, so a release
    // commit that only rewrites CHANGELOGs does not re-run every dependent's
    // typecheck.
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    // `inputs` below is *subtractive*, not an allowlist. Turborepo's default is
    // "every non-gitignored file in the package", and naming any input replaces
    // that default outright — so a hand-written list is a promise that nothing
    // outside it can change a test result, and a wrong promise shows up as a
    // stale green run rather than a loud failure. Every package now keeps its
    // tests in `tests/` at the package root, but a suite's INPUTS still reach
    // well outside it: the tests read `src/`, `public/_headers`, `*.astro`
    // pages and `seed/*.sql` as text, and `osn/db`, `pulse/db` and `zap/db`
    // read `drizzle/*.sql` off disk while testing, so an allowlist missing any
    // of those would report a migration change as already-passing.
    // `$TURBO_DEFAULT$`
    // keeps the default set and subtracts from it, which puts the risk the
    // other way round: the worst a wrong exclusion does is re-run a suite that
    // did not need re-running.
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    // Tests that read files outside their own package, split from `test` so
    // the rest stay cached when only those outside files change. A package
    // with no `test:repo` script runs nothing; one that has it names the
    // outside files in its own turbo.json and makes its `test` depend on it.
    "test:repo": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ]
    },
    "test:d1": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    // Serial, like `test:d1` above and for a neighbouring reason. Each project
    // in this task starts its own Vite server AND its own Chromium; six of them
    // at once on a 4-core runner took down a different one on three of six runs
    // — `@musubi/social` once, `@shared/ui` once — each time after
    // `Port 63315 is in use, trying another one...` and a navigation that never
    // completed. A failure that moves between packages is contention, not a
    // test, and the concurrency lives in the root script because turbo has no
    // per-task setting for it.
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "passThroughEnv": [
        "VITEST_BROWSER_EXECUTABLE_PATH",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"
      ]
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
