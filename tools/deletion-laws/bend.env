# The one pin of the Bend release the deletion proofs run on: the version and
# the SHA-256 of each platform's release tarball
# (github.com/bendlang/bend/releases/download/v<version>/bend-<version>-<target>.tar.gz),
# as bend-lang.com/install.sh records them for that version.
# scripts/install-bend.sh checks every tarball against these; bend.sh refuses
# another installed version; CI's `bend-proofs` job reads this file.
BEND_VERSION=2.0.40
BEND_SHA256_DARWIN_ARM64=b2be003b041eb6cfc65326be18f79eb2e0bae2189be79a18c507e661b4b6900b
BEND_SHA256_DARWIN_X64=9229c8bdd0a93f63fa45cc5af5e9e56389ebb620d655920915daf966c6ca561c
BEND_SHA256_LINUX_ARM64=2f42a6fa34ecdaa71ae105e5fa734f9a07e129d333e45448ab6d2ff03a837570
BEND_SHA256_LINUX_X64=c9ff8d67bd903fb6ad9a26b43d8a62c01021de82a44d55ce4a3dcd4732113d6b
