+  if (parts.length !== 2 || !HOSTNAME.test(host) || !PAGES_TARGET.test(target)) {
+    throw new Error(
+      `${REPLACE_CNAME_ENV} must name exactly one host and its Pages project's name, as <host>=<project>.pages.dev, in lower case; ${UNCHANGED}`,
+    );
+  }
+  return { host, target };
+};
