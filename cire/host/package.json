  "repository": {
    "type": "git",
    "url": "git+https://github.com/englishstreetventures/osn.git"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "dev-env astro dev",
    "build": "astro build && bun run ../../scripts/check-astro-fonts.ts dist && ../../scripts/guard-bundle-size.sh .",
    "preview": "astro preview",
    "test": "bunx --bun vitest --project unit",
    "test:mutation": "TZ=Australia/Sydney bun ../../tools/stryker/src/cli.ts",
    "test:run": "bunx --bun vitest run --project unit",
    "test:browser": "bunx --bun vitest run --project browser",
    "typecheck": "bun ../../scripts/astro-typecheck.ts"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@cire/dietary": "workspace:*",
    "@cire/guest-email": "workspace:*",
    "@cire/invite-designs": "workspace:*",
    "@cire/theme": "workspace:*",
    "@cire/ui": "workspace:*",
    "@kobalte/core": "^0.13.14",
    "@shared/db-utils": "workspace:*",
    "@shared/design-tokens": "workspace:*",
    "@shared/realtime": "workspace:*",
    "@shared/rp-auth": "workspace:*",
    "@shared/sortable": "workspace:*",
    "@shared/toast": "workspace:*",
    "@shared/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "cropperjs": "^2.2.0",
    "lucide-solid": "^1.47.0",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "web-haptics": "0.0.6"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
