---
import '../styles/global.css'
import SiteNav from '../components/SiteNav.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../lib/site'
import { Font } from 'astro:assets'

interface Props {
  /** Document <title>. Defaults to the brand + tagline. */
  title?: string
  /** Meta description / og:description. */
  description?: string
  /** Hide the footer (legal pages render their own chrome). */
  footer?: boolean
}

const {
  title = `${SITE_NAME}: ${SITE_TAGLINE}`,
  description = SITE_DESCRIPTION,
  footer = true,
} = Astro.props

// Canonical URL for this page (Astro.site comes from astro.config `site`).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Open Graph / Twitter — elegant share cards. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/cire-social.jpg", Astro.site ?? "https://cireweddings.com").href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cire: your wedding, beautifully together. Invitation and planning workspace." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/images/cire-social.jpg", Astro.site ?? "https://cireweddings.com").href} />
    <meta name="theme-color" content="#0d1f17" />

    <noscript>
      {/* No JS ⇒ the scroll-reveal observer never runs, so reveal everything up
          front rather than leaving it hidden (SEO + accessibility). */}
      <style is:inline>[data-reveal]{opacity:1 !important;transform:none !important}</style>
    </noscript>
    <!-- Both faces are above the fold — the wordmark is Cormorant, the copy beside
         it is Lato — so both preload. A bare `preload` ignores each face's
         `unicode-range` and fetches every subset unconditionally — naming
         the subset keeps the preload to what the page can actually use
         on this page). -->
    <Font cssVariable="--font-cormorant" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-lato" preload={[{ subset: "latin" }]} />
  </head>
  <body>
    <div class="page-root">
      <SiteNav />
      <slot />
      {footer && <SiteFooter />}
    </div>

    {/* Scroll-reveal: add `data-revealed` to any `[data-reveal]` as it enters the
        viewport. Progressive — with no JS the elements simply render (the CSS
        keeps them hidden only while JS can later reveal them, so we reveal-all as
        a fallback below). Reduced motion zeroes the transition (see global.css). */}
    <script is:inline>
      ;(() => {
        const els = Array.from(document.querySelectorAll('[data-reveal]'))
        if (els.length === 0) return
        if (!('IntersectionObserver' in window)) {
          for (const el of els) el.setAttribute('data-revealed', '')
          return
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute('data-revealed', '')
                entry.target.removeAttribute('data-pending')
                obs.unobserve(entry.target)
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        )
        for (const el of els) {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) el.setAttribute('data-pending', '')
          io.observe(el)
        }
      })()
    </script>
  </body>
</html>
