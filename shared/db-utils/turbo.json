{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The `package` project reads only this package's files; the `repo`
    // project (vitest.config.ts) also reads the Worker source trees the
    // rows-affected guard scans and every Worker's Wrangler config, to find
    // the Workers that bind D1, so only it reruns when one of those changes.
    // tests/no-raw-rows-affected.test.ts fails unless each is an input here.
    "test": {
      "dependsOn": ["^build", "test:repo"]
    },
    "test:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/osn/api/src/**",
        "$TURBO_ROOT$/cire/api/src/**",
        "$TURBO_ROOT$/zap/api/src/**",
        "$TURBO_ROOT$/pulse/api/src/**",
        "$TURBO_ROOT$/shared/billing/src/**",
        "$TURBO_ROOT$/*/*/wrangler.toml",
        "$TURBO_ROOT$/*/*/wrangler.jsonc",
        "$TURBO_ROOT$/*/*/wrangler.json"
      ]
    }
  }
}
