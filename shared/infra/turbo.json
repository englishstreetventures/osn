{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The `package` project reads only this package's files; the `repo`
    // project (vitest.config.ts) also reads the Worker sources, the lockfile
    // (which pins the wrangler it reads and the Alchemy tree it reads), the
    // root turbo.json,
    // the cire packages' own turbo.json, the Wrangler configs, the workflows, the stack
    // declarations and the asset sites' public directories (their `_headers`
    // included), so only it reruns when one of those changes.
    // tests/package.test.ts holds the last two to the sites the tests read.
    // The `alchemy` project runs this package's Alchemy scripts, so its
    // result depends on the installed tree alone: the lockfile, the root
    // manifest (its overrides, patches and devDependencies, which Alchemy's
    // CLI searches for providers), bunfig.toml, the patches and the Bun
    // version. It does not rerun on a Worker source, workflow or asset edit.
    // tests/package.test.ts holds `test` to running it, and its inputs.
    "test": {
      "dependsOn": ["^build", "test:repo", "test:alchemy"]
    },
    // The D1 tier (tests/d1): Wrangler, from cire/api's install, builds each
    // production database's history from the migration directories, and the
    // installed Alchemy provider converts it with the stacks' own migration
    // sources. It reruns when any of those, a Wrangler config or the
    // installed tree changes, and keeps its artifact.
    "test:d1": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/cire/db/migrations/**",
        "$TURBO_ROOT$/cire/db/migrations-archive/**",
        "$TURBO_ROOT$/osn/db/drizzle/**",
        "$TURBO_ROOT$/zap/db/drizzle/**",
        "$TURBO_ROOT$/cire/api/wrangler.toml",
        "$TURBO_ROOT$/osn/api/wrangler.toml",
        "$TURBO_ROOT$/zap/api/wrangler.toml",
        "$TURBO_ROOT$/cire/infra/src/declaration.ts",
        "$TURBO_ROOT$/musubi/infra/src/declaration.ts",
        "$TURBO_ROOT$/zap/infra/src/declaration.ts"
      ],
      "outputs": ["d1-artifacts/**"]
    },
    "test:alchemy": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/.bun-version"
      ]
    },
    "test:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/osn/api/src/**",
        "$TURBO_ROOT$/cire/api/src/**",
        "$TURBO_ROOT$/zap/api/src/**",
        "$TURBO_ROOT$/cire/invites/src/**",
        "$TURBO_ROOT$/**/*wrangler.toml",
        "$TURBO_ROOT$/**/*wrangler.jsonc",
        "$TURBO_ROOT$/**/*wrangler.json",
        "!$TURBO_ROOT$/**/node_modules/**",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/cire/*/turbo.json",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/cire/infra/src/declaration.ts",
        "$TURBO_ROOT$/musubi/infra/src/declaration.ts",
        "$TURBO_ROOT$/pulse/infra/src/declaration.ts",
        "$TURBO_ROOT$/zap/infra/src/declaration.ts",
        "$TURBO_ROOT$/cire/host/public/**",
        "$TURBO_ROOT$/cire/vendor/public/**",
        "$TURBO_ROOT$/cire/landing/public/**",
        "$TURBO_ROOT$/cire/invites/public/**",
        "$TURBO_ROOT$/musubi/social/public/**",
        "$TURBO_ROOT$/musubi/landing/public/**",
        "$TURBO_ROOT$/pulse/landing/public/**"
      ]
    }
  }
}
