{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // tests/scripts/d1-latency-probe.test.ts reads two files outside this
    // package: the probe's workflow, and @shared/infra's hosts.ts, whose
    // PRODUCTION_ZONES the probe repeats. Named here, a change to either
    // re-runs the suite rather than replaying a cached green.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/shared/infra/src/hosts.ts",
        "$TURBO_ROOT$/.github/workflows/cire-d1-latency-probe.yml"
      ]
    }
  }
}
