{
  "name": "@musubi/social",
  "version": "0.17.0",
  "private": true,
  "description": "Musubi \u2014 identity and social graph app, built on OSN",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "dev-env vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "bunx --bun vitest --project unit",
    "test:run": "bunx --bun vitest run --project unit",
    "test:browser": "bunx --bun vitest run --project browser"
  },
  "portless": {
    "name": "musubi",
    "script": "dev:app"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@osn/client": "workspace:*",
    "@osn/auth-ui": "workspace:*",
    "@shared/ui": "workspace:*",
    "@shared/design-tokens": "workspace:*",
    "@shared/legal": "workspace:*",
    "@shared/toast": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "@solidjs/router": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@shared/dev-urls": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "happy-dom": "^20.12.2",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
