{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest",
    "node",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    // Effect.ts `_tag` discriminants and `_`-prefixed intentionally-unused
    // bindings are idiomatic here; this style rule leaked in via an oxlint
    // category re-shuffle and was never opted into.
    "no-underscore-dangle": "off",

    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": "off",
    "import/no-duplicates": "warn",

    "promise/no-return-wrap": "error",

    "unicorn/no-null": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/filename-case": "off",
    "unicorn/prefer-array-flat-map": "warn",
    // Noise in this architecture: boot-time factory modules (createXxxModule /
    // createXxxRoutes) and Effect-context DI mean inner functions legitimately
    // capture nothing, and SolidJS component bodies run once per mount.
    "unicorn/consistent-function-scoping": "off",

    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "warn",
    "vitest/require-mock-type-parameters": "off",

    "vitest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["it.effect", "effectIt.effect"] }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "effectIt.effect"],
        "assertFunctionNames": ["expect", "expectFailsWith", "assertNoAccountId"]
      }
    ],

    "jest/valid-expect": "off",
    "jest/no-standalone-expect": "off",
    "jest/require-to-throw-message": "off",

    "jsx-a11y/autocomplete-valid": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",

    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/interactive-supports-focus": "warn",
    // depth raised from the default 2: Solid components wrap text in
    // <For>/<Show> + styled spans, so real labels often sit 3-4 levels deep.
    "jsx-a11y/control-has-associated-label": ["warn", { "depth": 6 }],

    "no-unassigned-vars": "off",

    "node/no-process-env": "off",

    // anti-slop — vendored from github.com/dmmulroy/anti-slop at 446268e into
    // tools/oxlint/anti-slop. Rules that catch the type-system escape hatches
    // (`as`, `unknown`, `object`, runtime `typeof`) that generated code reaches
    // for instead of modelling the domain.
    //
    // Upstream ships all 15 at "error". Turning them all on here would have
    // meant 4686 diagnostics across 541 files on day one, so the severities
    // below were adopted as a ratchet: one clean-up pass per rule, each rule
    // raised to "error" only once application source was clear of it.
    //
    // The ratchet is finished. 12 of the 15 are at "error"; the last three are
    // deliberate non-adoptions with the evidence recorded against each.

    // Clean today (0 hits in app source) — hold the line.
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-shape-in-symbol-names": "error",

    // Cleared in application source — raised off the ratchet. The test
    // override below still silences the test-side hits.
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",

    // Not adopted. These three were measured rather than deferred: the ratchet
    // above finished at 12 of 15, and clearing the last three would cost more
    // than it buys. Counts are src/test, re-measured 2026-08-18.
    //
    // 636 src / 2158 test. The rule wants a comment justifying every `as`.
    // Writing 636 of them by hand produces 636 comments nobody reads and no
    // reviewer trusts — the exact filler this ruleset exists to catch. The
    // assertions themselves are worth deleting; a comment mandate does not
    // delete one.
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    // 378 src / 137 test. `allowInTypeGuards: true` only spares 40 of the 378,
    // because the guard exemption needs a `value is X` return annotation and
    // most `typeof` here is inline narrowing inside a normal function
    // (`typeof x === "string" ? x : String(x)`) or a capability probe
    // (`typeof window === "undefined"` for SSR). That is idiomatic TypeScript
    // narrowing, not a modelling failure.
    "anti-slop/no-runtime-typeof": "off",
    // 149 src / 134 test. Fires on a bare `unknown` parameter — `unknown[]`,
    // `Record<string, unknown>` and any named alias are exempt, and the only
    // exemption is a parameter literally named `cause`. The rule exposes no
    // options. Classifying the 149: type-guard predicates (whose parameter
    // MUST be `unknown` — `value is X` on a narrower parameter guards
    // nothing), wire parsers taking a JSON body straight off `fetch`, error
    // narrowing in `catch`, and redaction/normalisation walkers. The two ways
    // to silence it are both worse: a `type Unparsed = unknown` alias launders
    // the rule while changing nothing, and a real `JsonValue` union converts
    // ~149 lint hits into ~149 call-site assertions feeding the backlog above.
    "anti-slop/no-unknown-parameters": "off",

    // house — rules written here, in tools/oxlint/house, for a bug class this
    // repo has hit and no published rule covers.
    //
    // A guard that narrows to a map's key type must test Object.hasOwn, never
    // `key in MAP`: `in` walks the prototype chain, so `constructor`,
    // `toString` and `__proto__` satisfy the guard and the predicate then
    // claims an inherited Object.prototype member is a real entry.
    "house/no-in-operator-key-guard": "error"
  },
  "overrides": [
    {
      // Tests: sequential awaits in loops are usually the point
      // (rate-limit windows, ordered seeding).
      "files": ["**/*.test.*", "**/tests/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*", "**/tests/**", "**/__tests__/**"],
      "rules": {
        // `Reflect.get(target, prop, receiver)` inside a Proxy `get` trap is
        // the correct idiom — plain `target[prop]` drops receiver forwarding
        // and breaks getters. Every hit we have is a drizzle-stubbing trap.
        "anti-slop/no-reflect-get": "off",
        // Request helpers forward arbitrary JSON bodies; `body: object` is the
        // honest type there, and narrowing it would only move the complaint to
        // no-unsafe-dictionary-type.
        "anti-slop/no-object-parameters": "off",
        // `vi.mock` is how this suite isolates modules. Replacing it means
        // reshaping the code under test, which is a separate argument.
        "anti-slop/no-module-mocking": "off",
        // Fixture and stub names describe the shape on purpose.
        "anti-slop/no-shape-in-symbol-names": "off",
        // Source is clean and the rule is an error there; 161 test-side hits
        // remain. Most are a fixture cast to the shape under test, which is a
        // different argument from a production `as` chain.
        "anti-slop/no-chained-type-assertions": "off",
        // Source is clean and the rule is an error there; 18 test-side hits
        // remain, all of them a fetch/JSON helper a single test file uses to
        // poke at a response it then asserts on by hand.
        "anti-slop/no-unknown-returns": "off",
        // Source is clean and the rule is an error there; 102 test-side hits
        // remain. Nearly all are a `Record<string, unknown>` stub for a
        // request body or a drizzle row the test then asserts on field by
        // field.
        "anti-slop/no-unsafe-dictionary-type": "off",
        // Source is clean and the rule is an error there; 25 test-side hits
        // remain, every one of them a request-body or options helper that
        // folds an optional argument into a fixture.
        "anti-slop/no-conditional-empty-object-spread": "off",
        // Source is clean and the rule is an error there; 62 test-side hits
        // remain, nearly all a fixture table or a stub response annotated
        // `Record<string, …>` so the test can index it with a computed key.
        "anti-slop/no-known-value-widening": "off"
      }
    }
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "house", "specifier": "./tools/oxlint/house/index.ts" }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".turbo",
    "*.gen.ts",
    "*.astro",
    // Vendored upstream source — linted by its own repo, not ours.
    "tools/oxlint/anti-slop"
  ]
}
