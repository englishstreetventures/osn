---
import LegalPage from '../layouts/LegalPage.astro'
import { LEGAL_ENTITY, draftPending, isPlaceholder } from '@shared/legal'

// Highlight a detail only while THAT detail is still a placeholder. A page-wide
// flag would mark a filled field as pending the moment any other one wasn't.
const ph = (value: string) => (isPlaceholder(value) ? 'placeholder' : undefined)

// Name every field this page publishes that the shared identity check does
// not already cover. Leave one out and the banner can go while that field
// is still a token.
const draft = draftPending()
---
<LegalPage title="Refund Policy">
  {draft && (
    <div class="draft-banner">
      <strong>Draft</strong> — this notice is not final. Some details of the operator are
      still to be confirmed, and this banner disappears once they are.
    </div>
  )}

  <h1>Refund Policy</h1>
  <p class="meta">Last updated: 2026-11-18</p>

  <p>
    Cire&rsquo;s paid plans, Gold and Crimson, are one-time purchases for a single wedding. This
    policy explains when and how we refund them. It is offered by
    <span class={ph(LEGAL_ENTITY.name)}>{LEGAL_ENTITY.name}</span>, trading as Cire.
  </p>

  <h2>14-day change of mind</h2>
  <p>
    If you buy a plan and change your mind, we will refund it in full within
    <strong>14 days of purchase</strong>, provided you haven&rsquo;t substantially used what it
    added (for example, guests added beyond what your earlier plan holds, or gifts taken through
    the registry). Just email
    <a href={`mailto:${LEGAL_ENTITY.supportEmail}`}><span class={ph(LEGAL_ENTITY.supportEmail)}>{LEGAL_ENTITY.supportEmail}</span></a> with your order details.
  </p>

  <h2>If a payment cannot upgrade your wedding</h2>
  <p>
    If your payment goes through but we cannot move the wedding to the plan you paid for, we refund
    it in full automatically and email the wedding&rsquo;s owners to say so. You don&rsquo;t need to
    ask.
  </p>

  <h2>Your rights under the Australian Consumer Law</h2>
  <p>
    Our services come with guarantees that cannot be excluded under the Australian Consumer Law.
    If a plan has a major failure, you are entitled to a refund or to compensation for any
    reasonably foreseeable loss or damage; if the failure is minor, you are entitled to have it
    fixed in a reasonable time. Nothing in this policy limits those rights — the change-of-mind
    window above is in addition to them, not instead of them.
  </p>

  <h2>If you&rsquo;re outside Australia</h2>
  <p>
    Your local consumer laws (for example EU or UK consumer rights) are unaffected by this policy.
    Where they give you stronger rights, those apply.
  </p>

  <h2>How refunds are processed</h2>
  <p>
    Stripe takes payment for our plans, so refunds go back through Stripe to your original payment
    method — typically within 5&ndash;10 business days of approval. When a purchase is refunded,
    the wedding returns to the plan it was on before (unless the refund was a remedy for a fault we
    couldn&rsquo;t fix). The features the plan added lock again; for a Crimson plan, that
    includes a premium envelope, which your guests stop seeing. Nothing on the wedding is deleted: if it holds more guests than the
    earlier plan allows, they all stay, but no more can be added.
  </p>

  <h2>Contact</h2>
  <p>
    Refund requests and questions: <a href={`mailto:${LEGAL_ENTITY.supportEmail}`}><span class={ph(LEGAL_ENTITY.supportEmail)}>{LEGAL_ENTITY.supportEmail}</span></a>.
  </p>
</LegalPage>
