---
// Tabs that each hold a whole document, for a page that has to read, print
// and link without JavaScript (cireweddings.com/privacy: one notice for hosts,
// one for guests).
//
// Without JavaScript: the tab list is a row of links to each panel's id, and
// every panel follows, stacked, each opening with its own heading. All the
// text is in the HTML, in reading order.
//
// With JavaScript: the inline script below runs as soon as the parser reaches
// it — after the tab list, before any panel — and sets `data-selected` from
// the address (`#hosts`, `#guests`), else the first tab. The CSS hides every
// panel but the selected one from that moment, so the first paint already
// shows the right panel, and a link to `#guests` opens the Guests tab. It also
// follows hash changes, so the tabs keep working as links if the module
// script never loads. `lib/notice-tabs.ts` then adds the WAI-ARIA tabs roles,
// states and keys.
//
// `@shared/ui`'s Kobalte tabs do not fit: they render only the selected panel
// (or every other one `hidden`) and their triggers are buttons, so with
// JavaScript off the other panel's text is missing and `#guests` cannot select
// it.
interface Tab {
  /** The panel's id, and so the address fragment that opens it. */
  readonly id: string
  /** The tab's name, which is also its accessible name. */
  readonly label: string
  /** Who the panel is for, under the label and read as the tab's description. */
  readonly description: string
  /** The panel's own heading, shown without JavaScript and in print. */
  readonly heading: string
}

interface Props {
  readonly tabs: readonly Tab[]
  /** The tab list's accessible name. */
  readonly label: string
}

const { tabs, label } = Astro.props
const ids = tabs.map((tab) => tab.id)
const panels = await Promise.all(tabs.map((tab) => Astro.slots.render(tab.id)))

// One rule per tab: the selected panel shows. Generated because CSS cannot
// match an attribute's value against another element's.
const shown = `${tabs
  .map(({ id }) => `.notice-tabs[data-selected="${id}"] [data-notice-panel="${id}"]`)
  .join(',')}{display:block}`
---
<div class="notice-tabs" data-notice-tabs data-label={label}>
  <div class="notice-tabs__list" data-notice-tablist>
    {tabs.map((tab) => (
      <a
        class="notice-tabs__tab"
        href={`#${tab.id}`}
        id={`${tab.id}-tab`}
        data-notice-tab={tab.id}
        aria-labelledby={`${tab.id}-tab-label`}
        aria-describedby={`${tab.id}-tab-description`}
      >
        <span class="notice-tabs__label" id={`${tab.id}-tab-label`}>{tab.label}</span>
        <span class="notice-tabs__description" id={`${tab.id}-tab-description`}>
          {tab.description}
        </span>
      </a>
    ))}
  </div>
  <script is:inline define:vars={{ ids }}>
    const root = document.currentScript.closest('[data-notice-tabs]')
    const named = () => {
      const id = decodeURIComponent(location.hash.slice(1))
      return ids.includes(id) ? id : null
    }
    root.dataset.selected = named() ?? ids[0]
    addEventListener('hashchange', () => {
      const id = named()
      if (id) root.dataset.selected = id
    })
  </script>
  {/* The section carries the id the address names; the body inside it becomes
      the focusable tab panel. Kept apart so arriving at `#guests` does not move
      focus onto a whole notice and draw a focus ring round it. */}
  {tabs.map((tab, index) => (
    <section
      class="notice-tabs__panel"
      id={tab.id}
      data-notice-panel={tab.id}
      aria-labelledby={`${tab.id}-heading`}
    >
      <div class="notice-tabs__body" id={`${tab.id}-panel`} data-notice-body>
        <h2 class="notice-tabs__title" id={`${tab.id}-heading`}>{tab.heading}</h2>
        <Fragment set:html={panels[index]} />
      </div>
    </section>
  ))}
</div>
<style is:inline set:html={shown}></style>

<script>
  import { enhanceNoticeTabs } from '../lib/notice-tabs'

  for (const root of document.querySelectorAll<HTMLElement>('[data-notice-tabs]')) {
    enhanceNoticeTabs(root)
  }
</script>

<style is:global>
  .notice-tabs {
    margin-top: 2rem;
  }

  /* The tab list: equal columns on a hairline, the selected tab underlined in
     gold. Without JavaScript the same row is a pair of jump links. */
  .notice-tabs__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    column-gap: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .legal .notice-tabs__tab {
    display: block;
    padding: 0.75rem 0 0.875rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .legal .notice-tabs__tab:hover {
    color: var(--color-text);
  }

  .legal .notice-tabs__tab[aria-selected='true'] {
    color: var(--color-text);
    border-bottom-color: var(--color-gold);
  }

  .legal .notice-tabs__tab:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
    border-radius: 0.125rem;
  }

  /* The label in the voice of the page's "Back to Cire" link; one word, so
     uppercase does not reach a screen reader as a shouted sentence. */
  .notice-tabs__label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .notice-tabs__description {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  /* A jump to `#guests` lands below the tab list, not under it. Positioned so
     the visually hidden heading below resolves inside its own panel. */
  .notice-tabs__panel {
    position: relative;
    scroll-margin-top: 7rem;
  }

  .notice-tabs__body:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 0.5rem;
    border-radius: 0.25rem;
  }

  /* Below the generated show rule in specificity, whichever stylesheet comes
     first. */
  :where(.notice-tabs[data-selected]) .notice-tabs__panel {
    display: none;
  }

  /* Each panel's own heading: what separates the two notices without
     JavaScript and on paper. */
  .legal .notice-tabs__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.2;
    margin: 2.75rem 0 0.375rem;
  }

  /* Inside a panel the notices' sections are h3 and their sub-sections h4,
     drawn as the legal pages draw h2 and the guest site draws h3. */
  .legal .notice-tabs__panel h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    margin: 2.25rem 0 0.625rem;
  }

  .legal .notice-tabs__panel h4 {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.02em;
    margin: 1.25rem 0 0.375rem;
    color: var(--color-gold);
  }

  @media screen {
    /* On screen the selected tab names its panel, so the heading is read
       but not shown. Print keeps it. */
    .notice-tabs[data-selected] .notice-tabs__title {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .notice-tabs[data-selected] .notice-tabs__panel {
      padding-top: 1.75rem;
    }
  }

  @media print {
    .notice-tabs__list {
      display: none;
    }
  }
</style>
