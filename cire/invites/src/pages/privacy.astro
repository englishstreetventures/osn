---
// Static page — prerendered at build time even though the site is `output:
// "server"`. Only the invite + bare-domain routes need per-request SSR.
//
// The notice itself is `@cire/ui`'s guest privacy notice, which cireweddings.com
// also publishes on the Guests tab of its own `/privacy`. This page adds the
// guest site's button that opens the guest's privacy choices, stored on this
// origin.
export const prerender = true
import GuestPrivacyNotice from '@cire/ui/guest-privacy-notice.astro'
import LegalLayout from '../layouts/LegalLayout.astro'
import { ConsentPreferencesLink } from '../components/consent/ConsentBanner'
import { LEGAL_ENTITY, draftPending } from '@shared/legal'

// Name every field this page publishes, the notice's included, that the
// shared identity check does not already cover. Leave one out and the banner
// can go while that field is still a token.
const draft = draftPending(LEGAL_ENTITY.regulator)
---
<LegalLayout title="Privacy Notice">
  {draft && (
    <div class="draft-banner">
      <strong>Draft</strong> — this notice is not final. Some details of the operator are
      still to be confirmed, and this banner disappears once they are.
    </div>
  )}

  <h1>Privacy Notice</h1>

  <GuestPrivacyNotice>
    <ConsentPreferencesLink slot="choices" client:idle label="Open my privacy choices" />
  </GuestPrivacyNotice>
</LegalLayout>
