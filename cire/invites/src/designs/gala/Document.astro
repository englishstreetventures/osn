---
import '../../styles/global.css'
import { apiPreconnectHref } from '../../lib/api-origin'
import { inviteTitle } from '../../lib/invite-title'
import InviteHeader from './InviteHeader'
import InvitePage from './InvitePage'
import { filterThemeVars, paletteRootVars, sectionVars, styleAttr } from '../../components/invite-theme'
import { GiftRegistryTeaser } from '../../components/gift-registry/GiftRegistryTeaser'
import SiteFooter from '../../components/SiteFooter.astro'
import { ConsentBanner } from '../../components/consent/ConsentBanner'
import type { InviteDesignProps } from '../types'

type Props = InviteDesignProps

const { apiUrl, slug, initialInvite, siteUrl } = Astro.props

// Preload the hero (the LCP element). It is ONE fixed-purpose variant, not a
// responsive set: `InviteHeader` always renders `?variant=hero-bg` (the
// server-blurred backdrop) with no srcset. So preload that exact URL — an
// imagesrcset of thumb/card/hero would make the browser fetch a second,
// sharp 1600w render at top priority that the page never displays, competing
// with the real LCP image for the same connection.
const heroBase = initialInvite?.hero.imageUrl ? `${apiUrl}${initialInvite.hero.imageUrl}` : null

// Tab title follows the couple's hero title when they've set one (e.g.
// "Anita & Ben — You're Invited"); the built-in default otherwise.
const pageTitle = inviteTitle(initialInvite?.hero.title)
// The invite's colour scheme, derived once and written into the SSR'd HTML so
// the FIRST paint is already themed. Without this a cream invite would flash
// the built-in dark green until the island hydrated. The islands re-apply it on
// their no-store revalidation (`applyPaletteToRoot`) so a colour the organiser
// just saved lands without a rebuild.
const paletteStyle = styleAttr(paletteRootVars(initialInvite?.theme ?? null))

const heroSep = heroBase?.includes('?') ? '&' : '?'
// Must stay in step with HERO_BG_VARIANT in components/invite-images.ts.
const preloadHeroHref = heroBase ? `${heroBase}${heroSep}variant=hero-bg` : null

// Warm the browser's connection to cire-api. See `lib/api-origin.ts` for why
// this is separate from the hero preload and why it carries no `crossorigin`.
const apiPreconnect = apiPreconnectHref(apiUrl)

// The gift-list band's surface, resolved server-side from the same SSR payload
// every other section uses — it keeps the registry section's own tone, so the
// band and the page it links to sit on the same colour. Filtered through the
// allow-list because it is spread into a `style` object in the island.
const registryVars = filterThemeVars(sectionVars(initialInvite?.theme ?? null, 'registry'))
---
<!DOCTYPE html>
<html lang="en" style={paletteStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* S-L1: keep the ?code= preview credential out of cross-origin Referer headers. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    {/* First-party API origin, hinted BEFORE the third-party font hosts: the
        claim POST (and the session restore beside it) is the interaction the
        guest is waiting on, and the hero image is served from here too.

        BOTH pools are warmed, because the page genuinely uses both and browsers
        keep them separate. Credentialed (no `crossorigin`): the hero <img>, the
        claim POST, the session restore, RSVP. Anonymous (`crossorigin`): the
        islands' `GET /api/invite/:slug` revalidation, which sends no credentials
        and is the FIRST browser->API request on the page (InviteHeader is
        client:load). Hinting only one leaves the other paying a full
        DNS+TCP+TLS handshake. */}
    {apiPreconnect && <link rel="preconnect" href={apiPreconnect} />}
    {apiPreconnect && <link rel="preconnect" href={apiPreconnect} crossorigin />}
    {preloadHeroHref && <link rel="preload" as="image" href={preloadHeroHref} />}
  </head>
  <body>
    <InviteHeader client:load apiUrl={apiUrl} slug={slug} initial={initialInvite} />
    {/* rootMargin so the island hydrates while the full-viewport hero is
        still on screen. Bare `client:visible` cannot fire at scroll position
        0 (the hero is `min-h-dvh`), which would delay the session restore
        until the guest has already scrolled to the code form — i.e. to the
        exact moment they are waiting on its result. */}
    <InvitePage
      client:visible={{ rootMargin: "600px" }}
      apiUrl={apiUrl}
      slug={slug}
      siteUrl={siteUrl}
      theme={initialInvite?.theme ?? null}
      details={initialInvite?.details ?? null}
      welcomeMessage={initialInvite?.welcome?.message ?? null}
    />
    {/* The couple's gift list — a band that links to it, not the list itself:
        that lives at `/<slug>/registry` now, because it is the part of an
        invitation a guest comes BACK to. Its OWN island, deliberately after
        InvitePage, for a hydration reason rather than an auth one: `InvitePage`
        reveals in place after a claim, and a band nested inside it would only
        exist once that reveal had run. The band reads the same gate the rest of
        the invitation does and renders NOTHING for a visitor with no claim (401)
        or a wedding with no published list (404). `client:visible` because it is
        below the fold on every invite. */}
    <GiftRegistryTeaser
      client:visible={{ rootMargin: "600px" }}
      apiUrl={apiUrl}
      slug={slug}
      eyebrow={initialInvite?.registry?.eyebrow ?? null}
      heading={initialInvite?.registry?.heading ?? null}
      body={initialInvite?.registry?.body ?? null}
      themeVars={registryVars}
    />
    {/* Site-wide chrome: the couple's name over the legal links. Always here,
        on the invite and on the legal pages alike. The couple's own sign-off is
        a section INSIDE InvitePage above — it sits behind the claim gate. */}
    <SiteFooter closing={initialInvite?.hero.title ?? null} />
    {/* Site-wide consent surface. `client:idle` so it never competes with the
        invite's first paint — nothing third-party can load before it hydrates
        anyway, since every ConsentGate defaults to denied until then. */}
    <ConsentBanner client:idle />
  </body>
</html>
