{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // tests/laws/ compares the deletion model that tools/deletion-laws
    // compiles to model.mjs with this package's services. It runs as
    // `test:repo`, which names that file and its types, so the other suites
    // stay cached when only the model changes. The type check reads the
    // types too, beside the root task's own input.
    "test": {
      "dependsOn": ["^build", "test:repo"]
    },
    "test:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/tools/deletion-laws/model.mjs",
        "$TURBO_ROOT$/tools/deletion-laws/model.d.mts"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/astro-typecheck.ts",
        "$TURBO_ROOT$/tools/deletion-laws/model.d.mts"
      ]
    },
    // tests/d1/worker-e2e.test.ts writes its results outside this package, to
    // the repository's e2e-artifacts/, which CI uploads. Declared here, a
    // cached run restores that file instead of leaving the upload empty.
    "test:d1": {
      "outputs": ["$TURBO_ROOT$/e2e-artifacts/osn-api-workerd/**"]
    }
  }
}
