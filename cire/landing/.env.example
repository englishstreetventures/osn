# NOTE: the cross-app URLs below are only read when the devloop runs WITHOUT
# portless. Under `bun run dev` the `dev-env` launcher (@shared/dev-urls)
# derives them from this app's own portless hostname — per worktree — and
# overrides whatever is set here. See CLAUDE.md > Local URLs.

# cire/landing — marketing site build vars (all PUBLIC_*, baked in at build time).
# Copy to `.env` for local overrides; CI passes the production values in
# production-release.yml and the dev values in deploy.yml.

# Organiser portal — target of the primary "Create your invitation" CTA.
# End-state prod value is https://host.cireweddings.com (see the migration plan
# in wiki/cire/cire-landing.md). Unset ⇒ the dev default in src/lib/site.ts.
PUBLIC_ORGANISER_URL=http://localhost:4322

# Optional: a real seeded demo invitation for the "See a live invite" CTA.
# Unset ⇒ the CTA scrolls to the in-page interactive (no-op) demo instead.
# PUBLIC_DEMO_INVITE_URL=https://cireweddings.com/cire-wedding?code=DEMO-IVY-AA11

# Optional. The commit this build was made from; the deploy workflows set it to
# `github.sha`. The footer prints its first seven characters as the version, or
# "local" when it is unset.
# PUBLIC_BUILD_SHA=
