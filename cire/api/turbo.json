{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // tests/scripts/d1-latency-probe.test.ts reads three files outside this
    // package: the probe's workflow, @shared/infra's hosts.ts, whose
    // PRODUCTION_ZONES the probe repeats, and scripts/smoke-check.ts, whose
    // CI_USER_AGENT the probe sends. Named here, a change to any of them
    // re-runs the suite rather than replaying a cached green. The Miniflare
    // suite is left out: the `test` script skips it (`--path-ignore-patterns`
    // in package.json), and `test:d1` hashes and runs it.
    //
    // Only tests/laws/ reads laws/, and only the compiled model.mjs and its
    // types there, never a .bend file. So `test` and the type check (which
    // reads the tests) leave the .bend files out, and the build and the D1
    // tier leave the whole folder out: a proof-only edit reruns none of them.
    // `transit`, which the type check depends on, hashes the package's files
    // too, so it leaves the .bend files out as well.
    "transit": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!laws/**/*.bend"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!laws/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/astro-typecheck.ts", "!laws/**/*.bend"]
    },
    "test:d1": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!laws/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/db/d1-integration.test.ts",
        "!laws/**/*.bend",
        "$TURBO_ROOT$/shared/infra/src/hosts.ts",
        "$TURBO_ROOT$/.github/workflows/cire-d1-latency-probe.yml",
        "$TURBO_ROOT$/scripts/smoke-check.ts"
      ]
    }
  }
}
