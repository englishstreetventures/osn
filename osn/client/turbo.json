{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The `package` project reads only this package's files; the `repo`
    // project (vitest.config.ts) also reads shared/openapi/osn.json, the
    // spec CI regenerates from osn-api's routes, so only it reruns when the
    // spec changes.
    "test": {
      "dependsOn": ["^build", "test:repo"]
    },
    "test:repo": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/shared/openapi/osn.json"]
    }
  }
}
