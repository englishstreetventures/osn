{
  "name": "@pulse/api",
  "version": "0.27.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "dev-env bun run --watch src/local.ts",
    "dev:wrangler": "wrangler dev --env dev",
    "build": "wrangler deploy --env dev --dry-run --outdir dist",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "test": "bunx --bun vitest",
    "test:run": "bunx --bun vitest run",
    "test:d1": "bun test tests/d1/d1-integration.test.ts"
  },
  "portless": {
    "name": "api.pulse",
    "script": "dev:app"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "1.4.15",
    "@pulse/db": "workspace:*",
    "@shared/crypto": "workspace:*",
    "@shared/db-utils": "workspace:*",
    "@shared/observability": "workspace:*",
    "@shared/openapi-tools": "workspace:*",
    "@shared/osn-auth-client": "workspace:*",
    "@shared/rate-limit": "workspace:*",
    "@shared/redis": "workspace:*",
    "@zap/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.112",
    "elysia": "^1.4.30",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@effect/vitest": "4.0.0-rc.112",
    "@shared/dev-urls": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "miniflare": "^4.20260730.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
