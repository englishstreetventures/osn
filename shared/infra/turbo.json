{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The `package` project reads only this package's files; the `repo`
    // project (vitest.config.ts) also reads the Worker sources, the lockfile
    // and the workflows, so only it reruns when one of those changes.
    "test": {
      "dependsOn": ["^build", "test:repo"]
    },
    "test:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/osn/api/src/**",
        "$TURBO_ROOT$/cire/api/src/**",
        "$TURBO_ROOT$/zap/api/src/**",
        "$TURBO_ROOT$/cire/invites/src/**",
        "$TURBO_ROOT$/osn/api/wrangler.toml",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/.github/workflows/**"
      ]
    }
  }
}
