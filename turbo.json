{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "fmt": {},
    "check": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:d1": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "VITEST_BROWSER_EXECUTABLE_PATH",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"
      ]
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
