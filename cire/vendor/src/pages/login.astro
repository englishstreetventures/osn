---
import '../styles/global.css'
// Self-hosted webfonts (C-L33) — no Google Fonts request.
import '../lib/fonts'
import SignInPanel from '../components/SignInPanel'
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Vendor — Cire</title>
  </head>
  <body>
    <main class="mx-auto max-w-[480px] px-8 py-24">
      <header class="mb-8 flex flex-col gap-2 text-center">
        <p class="font-body text-[0.72rem] uppercase tracking-[0.2em] text-gold">
          Vendor Portal
        </p>
        <h1 class="font-display text-[clamp(1.8rem,4vw,2.5rem)] font-light italic leading-[1.1] text-text">
          Login
        </h1>
      </header>
      <div class="rounded-sm border border-border bg-surface p-8">
        <SignInPanel client:only="solid-js" />
      </div>
    </main>
  </body>
</html>
