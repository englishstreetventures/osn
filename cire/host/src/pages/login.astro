---
import { Font } from 'astro:assets'

import SignInCard from '@cire/ui/sign-in-card.astro'

import '../styles/global.css'
import { CIRE_API_URL } from '../lib/osn'
import { THEME_BOOT_SCRIPT } from '../lib/preference-keys'
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Host portal — Cire</title>
    <!-- Same boot script as the dashboard, for the same reason: sign-in is the
         first page a host sees, and it is the one most likely to be opened at
         night. It must not paint a frame of the wrong theme. -->
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>
    <!-- A bare `preload` ignores each face's `unicode-range` and fetches
         every subset unconditionally — naming the subset keeps the preload
         to what the page can actually use. -->
    <Font cssVariable="--font-ui" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-flair" preload={[{ subset: "latin" }]} />
  </head>
  <!-- The page's body is `@cire/ui`'s `SignInCard`, the same as the vendor
       portal's but for the portal's name. Its heading is sized from the page's
       container, so the body carries `@container/frame`. -->
  <body class="@container/frame">
    <SignInCard portal="host" apiBase={CIRE_API_URL} />
  </body>
</html>
