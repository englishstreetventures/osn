+
+/** A host the check found holding exactly its CNAME to the target, in the zone `zoneId` named `zone`. */
+export interface Replacement extends ReplaceCname {
+  readonly zoneId: string;
+  /** The zone's name as Cloudflare gives it: the host is the zone's apex when the two are equal. */
+  readonly zone: string;
