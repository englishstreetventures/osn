# Security headers for the static marketing site (Cloudflare Pages honours this
# file for every response). The landing page is fully static and talks to no
# first-party API, so unlike the organiser portal it CAN carry a tight CSP:
#   - script-src: own bundles ('self') + the small inline reveal/hydration
#     scripts ('unsafe-inline' — Astro's island bootstrap + our is:inline IO).
#   - style-src 'unsafe-inline': Astro inlines small critical CSS.
#   - font-src 'self': the faces are SELF-HOSTED — `astro.config.mjs`
#     downloads them at build time via `fontProviders.google()`, so no
#     fonts.googleapis.com / fonts.gstatic.com, and no visitor's IP address
#     or user agent goes to Google.
#   - img-src 'self' data:: the one photograph is SELF-HOSTED too, under
#     /images/ (src/lib/site.ts `IMAGES`), so no image host sees a visitor
#     either. tests/self-hosted-images.test.ts holds this line to it.
# Production serves this file through Cloudflare Pages, and the staged Worker
# on next.cireweddings.com honours it as well; `astro dev` does not apply it.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Long-cache the immutable hashed bundles.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The photograph's file names carry no content hash, so they are cached for a
# day, not forever: a replaced image reaches every browser within a day.
/images/*
  Cache-Control: public, max-age=86400
