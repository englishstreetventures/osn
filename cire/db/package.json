{
  "name": "@cire/db",
  "private": true,
  "license": "UNLICENSED",
  "author": "English Street Ventures Pty Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/englishstreetventures/osn.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/schema.ts",
    "./seed": "./seed/data/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test:migration-flow": "MIGRATION_FLOW=1 bun test tests/migration-flow.test.ts",
    "test": "bun test",
    "test:mutation": "bun ../../tools/stryker/src/cli.ts",
    "seed:generate": "bun run seed/generate.ts",
    "assets:seed:dev": "bun run seed/assets.ts",
    "db:generate": "bun run ../../scripts/db-generate.ts .",
    "db:studio": "drizzle-kit studio",
    "db:push": "bun run ../../scripts/cire-db-migrate.ts cire-db --local",
    "db:migrate:local": "bun run ../../scripts/cire-db-migrate.ts cire-db --local",
    "db:migrate:prod": "bun run ../../scripts/cire-db-migrate.ts cire-db --env production --remote",
    "db:seed": "bash ../../scripts/cire-db-seed.sh",
    "db:reset": "rm -rf ../api/.wrangler/state/v3/d1 && bun run db:push && bun run db:seed"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
