{
  "name": "@cire/invites",
  "private": true,
  "type": "module",
  "author": "English Street Ventures Pty Ltd",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/englishstreetventures/osn.git"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "dev-env astro dev",
    "build": "astro build && ../../scripts/guard-bundle-size.sh . && scripts/guard-no-scene-in-server.sh .",
    "preview": "astro preview",
    "typecheck": "bun ../../scripts/astro-typecheck.ts && bun check --no-script -p tests/tsconfig.json",
    "favicon": "bun scripts/favicon.ts",
    "test": "vitest run --project unit --project ssr",
    "test:mutation": "bun ../../tools/stryker/src/cli.ts",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/solid-js": "7.1.0",
    "@cire/dietary": "workspace:*",
    "@cire/envelope": "workspace:*",
    "@cire/guest-email": "workspace:*",
    "@cire/invite-designs": "workspace:*",
    "@cire/theme": "workspace:*",
    "@cire/ui": "workspace:*",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@shared/design-tokens": "workspace:*",
    "@shared/legal": "workspace:*",
    "@shared/rp-auth": "workspace:*",
    "@shared/toast": "workspace:*",
    "@shared/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.4",
    "solid-js": "^1.9.18",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@cire/build-tools": "workspace:*",
    "@shared/dev-urls": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "^30.0.1",
    "playwright": "1.64.1",
    "typescript": "7.1.0-beta",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  },
  "portless": {
    "name": "invite.cire",
    "script": "dev:app"
  }
}
